;; shadow-cljs build for the rare-earth (rare-earth-ui-re4c0v26) appview UI.
;; Mirrors orgs/kotoba-lang/murakumo-studio/shadow-cljs.edn and
;; orgs/cloud-itonami/public-malak/shadow-cljs.edn:
;; CLJS + reagent on kotoba-ui.core + appkit.core (murakumo-studio構成).
{:deps {:aliases [:cljs]}
 :nrepl {:port 9633}

 :builds
 {:app
  {:target :browser
   :output-dir "web/dist/js"
   :asset-path "js"
   :modules {:main {:init-fn cloud-itonami.rare-earth.desktop/init!}}}}}
